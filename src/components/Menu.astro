---
interface Props {
  activeItem?: string;
}

const { activeItem } = Astro.props;
const menu = [
  {
    title: "Blog",
    href: "/blog",
  },
  {
    title: "Projects",
    href: "/projects",
  },
  {
    title: "Home",
    href: "/",
  },
  {
    title: "About",
    href: "/about",
  },
  {
    title: "Contact",
    href: "/contact",
  },
];
---

<header class="global-menu">
  <nav aria-label="Main navigation">
    {
      menu.map((item) =>
        item.title === "Home" ? (
          <div class="menu-item-home">
            <a href={item.href} aria-current={activeItem === item.title ? "page" : undefined}>ADC</a>
          </div>
        ) : (
          <div class={`menu-item ${item.title === activeItem ? "active" : ""}`}>
            <a href={item.href} aria-current={item.title === activeItem ? "page" : undefined}>{item.title}</a>
          </div>
        ),
      )
    }
  </nav>
</header>

<style lang="scss">
  header {
    position: fixed;
    z-index: 40;
    top: 0.85rem;
    left: 50%;
    display: flex;
    transform: translateX(-50%);
  }

  nav {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: center;
    align-items: center;
    background-color: rgba($color-accent-1, 0.92);
    border: 1px solid rgba($color-secondary, 0.34);
    border-radius: 4px;
    padding: 0 0.35rem;
    position: relative;
    width: max-content;
    gap: 0;
    height: 2.2rem;
    box-shadow: 0 0.75rem 2.5rem rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(12px);

    .menu-item {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 100%;
      padding: 0;
      position: relative;
      overflow: hidden;
      border-radius: 3px;

      a {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        padding: 0 0.25rem;
        text-decoration: none;
        color: $color-white;
        font-size: $fs-sm;
        white-space: nowrap;
        position: relative;
        z-index: 2;
        transition: color 0.3s ease;
        padding: 0 clamp(0.45rem, 2vw, 1rem);
      }

      &::before,
      &::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        height: 0;
        background-color: $color-accent-2;
        transition: height 0.3s ease;
        z-index: 1;
      }

      &::before {
        top: 0;
      }
      &::after {
        bottom: 0;
      }

      &.active {
        &::before,
        &::after {
          height: 3px;
        }
      }

      &:hover {
        &::before,
        &::after {
          height: 51%;
        }

        a {
          color: $color-text;
          font-weight: 800;
        }
      }
    }

    .menu-item-home {
      display: flex;
      background-color: $color-accent-2;
      font-size: $fs-lg;
      width: 3.15rem;
      height: 3.15rem;
      border-radius: 50%;
      align-items: center;
      justify-content: center;
      margin: 0 0.55rem;
      box-shadow: 0 0 0 6px $color-accent-1;
      z-index: 10;
      overflow: hidden;
      transition: background-color 0.3s ease;
      flex-shrink: 0;

      &:hover {
        background-color: $color-accent-1;
        a {
          color: $color-white;
        }
      }

      a {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        color: $color-text;
        font-weight: bold;
        text-decoration: none;
        border-radius: 50%;
        transition: color 0.3s ease;
      }
    }
  }

  @media (max-width: 540px) {
    header { top: 0.6rem; }
    nav { height: 2rem; padding: 0 0.15rem; }
    nav .menu-item a { padding: 0 0.38rem; font-size: 0.68rem; }
    nav .menu-item-home { width: 2.7rem; height: 2.7rem; margin: 0 0.3rem; font-size: 0.9rem; box-shadow: 0 0 0 4px $color-accent-1; }
  }
</style>
