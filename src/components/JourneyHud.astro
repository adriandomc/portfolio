---
import { stations } from "../lib/world-map";

const stops = stations.map((station, index) => ({
  id: station.id,
  title: station.title.replaceAll("\n", " "),
  index,
}));
---

<nav class="journey-rail" aria-label="Estaciones del viaje">
  <ol>
    {stops.map((stop) => (
      <li>
        <a href={`#${stop.id}`} data-rail-stop={stop.index} aria-label={`${String(stop.index + 1).padStart(2, "0")} — ${stop.title}`}>
          <span class="rail-dot" aria-hidden="true"></span>
          <span class="rail-title">{stop.title}</span>
        </a>
      </li>
    ))}
  </ol>
</nav>

<p class="journey-counter" aria-hidden="true">
  <span class="counter-index" data-journey-index>01</span>
  <span class="counter-total">/ {String(stops.length).padStart(2, "0")}</span>
  <span class="counter-title" data-journey-title>{stops[0].title}</span>
</p>

<p class="journey-hint" data-journey-hint aria-hidden="true">
  <span class="hint-chevron">⌄</span>
  scroll
</p>

<script>
  // This hoisted module runs ONCE per browser session while the ClientRouter swaps
  // pages under it — so never cache DOM nodes: query fresh on every sync, delegate
  // clicks at the document level, and re-arm per page via astro:page-load.
  let hintDismissed = false;
  let raf = 0;
  let pulseTimer: ReturnType<typeof setTimeout> | undefined;

  function sync() {
    raf = 0;
    if (!document.body.classList.contains("journey-home")) return;
    const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-rail-stop]")];
    if (!links.length) return;
    const range = document.documentElement.scrollHeight - innerHeight;
    const progress = range > 0 ? (scrollY / range) * (links.length - 1) : 0;
    const stop = Math.min(links.length - 1, Math.max(0, Math.round(progress)));
    links.forEach((link, index) => link.setAttribute("aria-current", index === stop ? "true" : "false"));
    const indexLabel = document.querySelector("[data-journey-index]");
    const titleLabel = document.querySelector("[data-journey-title]");
    if (indexLabel) indexLabel.textContent = String(stop + 1).padStart(2, "0");
    if (titleLabel) titleLabel.textContent = links[stop].querySelector(".rail-title")?.textContent ?? "";
    if (!hintDismissed && (scrollY > 40 || stop > 0)) {
      hintDismissed = true;
      document.querySelector("[data-journey-hint]")?.classList.add("dismissed");
    }
  }

  function queueSync() {
    if (!raf) raf = requestAnimationFrame(sync);
  }

  function arm() {
    hintDismissed = false;
    sync();
    clearTimeout(pulseTimer);
    pulseTimer = setTimeout(() => {
      if (!hintDismissed && scrollY <= 40) document.querySelector("[data-journey-hint]")?.classList.add("pulse");
    }, 1600);
  }

  addEventListener("scroll", queueSync, { passive: true });
  addEventListener("resize", queueSync, { passive: true });
  document.addEventListener("astro:page-load", arm);
  document.addEventListener("click", (event) => {
    const link = (event.target as HTMLElement | null)?.closest?.("[data-rail-stop]") as HTMLAnchorElement | null;
    if (!link || event.defaultPrevented) return;
    event.preventDefault();
    const target = document.getElementById(link.hash.slice(1));
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    target?.scrollIntoView({ behavior: reduced ? "auto" : "smooth" });
  });
  arm();
</script>

<style lang="scss">
  .journey-rail {
    position: fixed;
    z-index: 35;
    top: 50%;
    right: clamp(0.9rem, 2.2vw, 2rem);
    transform: translateY(-50%);
    // The parent .site-content--journey is pointer-inert while the world renders;
    // the rail must stay clickable.
    pointer-events: auto;

    ol {
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    a {
      display: flex;
      flex-direction: row-reverse;
      align-items: center;
      gap: 0.6rem;
      text-decoration: none;
    }

    .rail-dot {
      width: 0.55rem;
      height: 0.55rem;
      border: 1px solid rgba(#d7f2ba, 0.85);
      border-radius: 50%;
      background: transparent;
      box-shadow: 0 0 0.4rem rgba(0, 0, 0, 0.55);
      transition: background 0.25s ease, transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.25s ease;
    }

    .rail-title {
      max-width: 14rem;
      overflow: hidden;
      color: #d7f2ba;
      font: 700 0.68rem/1.2 "JetBrains Mono", monospace;
      letter-spacing: 0.06em;
      white-space: nowrap;
      text-shadow: 0 0.15rem 0.6rem #06050a;
      opacity: 0;
      transform: translateX(0.4rem);
      transition: opacity 0.2s ease, transform 0.25s ease;
      pointer-events: none;
    }

    a:hover .rail-title,
    a:focus-visible .rail-title,
    a[aria-current="true"] .rail-title {
      opacity: 1;
      transform: none;
    }

    a:hover .rail-dot,
    a:focus-visible .rail-dot {
      transform: scale(1.35);
    }

    a[aria-current="true"] .rail-dot {
      background: #d7f2ba;
      transform: scale(1.25);
      box-shadow: 0 0 0.7rem rgba(#d7f2ba, 0.8);
    }
  }

  .journey-counter {
    position: fixed;
    z-index: 35;
    bottom: 1.2rem;
    left: clamp(1rem, 3vw, 2.2rem);
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
    color: #d7f2ba;
    font: 800 0.78rem/1 "JetBrains Mono", monospace;
    letter-spacing: 0.08em;
    text-shadow: 0 0.15rem 0.6rem #06050a;

    .counter-index {
      font-size: 1.25rem;
    }

    .counter-total,
    .counter-title {
      color: rgba(#d7f2ba, 0.72);
    }

    .counter-title {
      max-width: 46vw;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }
  }

  .journey-hint {
    position: fixed;
    z-index: 35;
    bottom: 1.1rem;
    left: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    margin: 0;
    color: rgba(#d7f2ba, 0.85);
    font: 700 0.72rem/1 "JetBrains Mono", monospace;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    text-shadow: 0 0.15rem 0.6rem #06050a;
    transform: translateX(-50%);
    transition: opacity 0.5s ease;

    .hint-chevron {
      font-size: 1.1rem;
    }

    &.pulse .hint-chevron {
      animation: hint-bob 1.6s ease-in-out infinite;
    }

    &.dismissed {
      opacity: 0;
      pointer-events: none;
    }
  }

  @keyframes hint-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(0.35rem); }
  }

  @media (max-width: 767px) {
    .journey-rail .rail-title {
      display: none;
    }

    // Numbers only on phones so the counter never collides with the scroll hint.
    .journey-counter .counter-title {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .journey-hint.pulse .hint-chevron {
      animation: none;
    }
  }

  // In fallback mode the journey is plain readable text — the cinematic chrome goes away,
  // but the rail keeps working as plain anchor navigation.
  :global(html[data-world-render="fallback"]) .journey-counter,
  :global(html[data-world-render="fallback"]) .journey-hint {
    display: none;
  }
</style>
