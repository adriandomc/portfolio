---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import Menu from "../components/Menu.astro";
import { getCollection } from "astro:content";

const title = "Projects";

const projects = (await getCollection("projects", ({ data }) => !data.draft && data.featured))
  .sort((a, b) => (a.data.order ?? Infinity) - (b.data.order ?? Infinity))
  .slice(0, 6);
---

<BaseLayout title={title} description="Projects by Adrián Domínguez — a showcase of web development work.">
  <Menu activeItem="Projects" />
  <main id="main-content" class="projects-overview-content">
    <div class="heading-row">
      <h1>Projects</h1>
      <a href="/projects/all" class="show-all-link">Show all projects &rarr;</a>
    </div>
    <ul class="projects-map" aria-label="Featured project destinations">
      {
        projects.map((project) => {
          const detailHref = project.body?.trim() ? `/projects/${project.id}` : project.data.href;
          return (
            <li>
              <a href={detailHref} target={detailHref?.startsWith("http") ? "_blank" : undefined} rel="noopener noreferrer">
                <strong>{project.data.title}</strong>
                <span>{project.data.description}</span>
                <small>{project.data.tags.join(" · ")}</small>
              </a>
            </li>
          );
        })
      }
    </ul>
  </main>
</BaseLayout>

<style lang="scss">
  main {
    display: flex;
    flex-direction: column;
    margin-top: 2rem;
  }

  .heading-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .show-all-link {
    color: $color-accent-1;
    text-decoration: none;
    font-size: $fs-xl;
    transition: color 0.2s ease;

    &:hover {
      color: $color-accent-2;
    }
  }

  .projects-map {
    list-style: none;
    padding: 0;
    margin-top: 2rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;

    @include respond-to("tablet") {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .projects-map li {
    border-top: 1px solid rgba($color-accent-1, 0.7);
  }

  .projects-map a {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-height: 9rem;
    padding: 1rem 1rem 1rem 0;
    color: $color-text;
    text-decoration: none;
    transition: padding-left 0.2s ease, color 0.2s ease;

    &:hover {
      padding-left: 0.65rem;
      color: $color-accent-2;
    }

    strong {
      font-size: $fs-xl;
    }

    span {
      color: $color-accent-1;
      line-height: 1.45;
    }

    small {
      margin-top: auto;
      color: $color-accent-2;
    }
  }
</style>
