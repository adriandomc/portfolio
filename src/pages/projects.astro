---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import Menu from "../components/Menu.astro";
import ProjectShowcase from "../components/ProjectShowcase.astro";
import RevealOnScroll from "../components/RevealOnScroll.astro";
import { getCollection } from "astro:content";

const title = "Projects";

const projects = (
  await getCollection("projects", ({ data }) => !data.draft)
).sort((a, b) => (a.data.order ?? Infinity) - (b.data.order ?? Infinity));
---

<BaseLayout
  title={title}
  description="Projects by Adrián Domínguez — a showcase of web development work."
>
  <Menu activeItem="Projects" />
  <main id="main-content">
    <header class="page-head">
      <h1>Projects</h1>
      <p class="page-lead">
        Everything I have shipped, newest focus first — client platforms,
        products and tools.
      </p>
    </header>
    <div class="showcase-list">
      {
        projects.map((project) => (
          <ProjectShowcase
            title={project.data.title}
            description={project.data.description}
            summary={project.data.summary}
            role={project.data.role}
            year={project.data.year}
            tags={project.data.tags}
            images={project.data.images}
            href={project.data.href}
            detailHref={
              project.body?.trim() ? `/projects/${project.id}` : undefined
            }
          />
        ))
      }
    </div>
  </main>
  <RevealOnScroll />
</BaseLayout>

<style lang="scss">
  main {
    display: flex;
    flex-direction: column;
    margin-bottom: 4rem;
  }

  .page-head {
    padding: 3rem 0 1rem;

    @include respond-to("tablet") {
      padding: 4rem 0 1.25rem;
    }
  }

  .page-lead {
    margin-top: 0.75rem;
    max-width: 52ch;
    color: color.adjust($color-accent-1, $lightness: -10%);
    line-height: 1.6;
  }

  .showcase-list {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    margin-top: 3rem;

    @include respond-to("tablet") {
      gap: 6.5rem;
      margin-top: 4rem;
    }
  }
</style>
