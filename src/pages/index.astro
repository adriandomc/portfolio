---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import JourneyHud from "../components/JourneyHud.astro";
import { stations } from "../lib/world-map";

const lorem = "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer posuere, nibh vitae luctus fermentum, justo sapien sodales tellus.";
---

<BaseLayout title="ADC — Portfolio" description="Portfolio de Adrián Domínguez Casasola.">
  <JourneyHud />
  <main id="main-content" class="journey" aria-label="Recorrido por el portfolio">
    {stations.map((station) => (
      <section id={station.id} class="journey-stop" aria-labelledby={`${station.id}-title`}>
        <div class="scene-copy">
          <h1 id={`${station.id}-title`}>{station.title.replaceAll("\n", " ")}</h1>
          <p>{lorem}</p>
          <ul aria-label="Productos de la estación">
            {station.signage
              .filter((sign) => !("title" in sign))
              .map((sign) =>
                "route" in sign && sign.route ? (
                  <li><a href={sign.route}>{sign.text}</a></li>
                ) : (
                  <li>{sign.text}</li>
                ),
              )}
          </ul>
        </div>
      </section>
    ))}
  </main>
</BaseLayout>

<style lang="scss">
  .journey { position: relative; z-index: 1; }
  .journey-stop { min-height: 100svh; display: flex; align-items: center; padding: 6rem clamp(1rem, 7vw, 7rem) 4rem; scroll-snap-align: start; }
  .scene-copy { width: min(38rem, 100%); color: #d7f2ba; text-shadow: 0 0.2rem 1rem #090713; }
  .scene-copy h1 { max-width: 18ch; margin: 0.5rem 0 1rem; font-size: clamp(2rem, 6vw, 4rem); }
  .scene-copy p { max-width: 52ch; }
  .scene-copy ul { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; padding: 0; list-style: none; }
  .scene-copy li::before { content: "+ "; color: #79b4a9; }
  :global(html:is([data-world-render="ready"], [data-world-render="degraded"])) .scene-copy {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  :global(html[data-world-render="fallback"]) .scene-copy { position: static; width: min(38rem, 100%); height: auto; margin: 0; overflow: visible; clip: auto; white-space: normal; }
</style>
