---
export const prerender = true;

import BaseLayout from "../layouts/BaseLayout.astro";
import Menu from "../components/Menu.astro";
import ProjectShowcase from "../components/ProjectShowcase.astro";
import RevealOnScroll from "../components/RevealOnScroll.astro";
import { getCollection } from "astro:content";

const title = "Home";

const projects = (
  await getCollection("projects", ({ data }) => !data.draft && data.featured)
)
  .sort((a, b) => (a.data.order ?? Infinity) - (b.data.order ?? Infinity))
  .slice(0, 6);
---

<BaseLayout
  title={title}
  description="Portfolio of Adrián Domínguez, a software engineer from Mexico specializing in React, TypeScript, PHP and Node.js."
>
  <Menu activeItem="Home" />
  <main id="main-content">
    <header class="intro">
      <div class="intro-copy">
        <h1>
          <span class="intro-name">ADRIÁN DOMÍNGUEZ CASASOLA</span>
          <span class="intro-role">SOFTWARE ENGINEER</span>
        </h1>
        <p class="intro-line">
          I am a software engineer from Mexico, working across the whole web stack,
          from the design to the deployment of fully fledged products. Specialized in
          frontend web solutions.
        </p>
      </div>
      <img
        class="intro-avatar"
        src="/images/adrian.jpeg"
        alt="Adrián Domínguez Casasola"
        width="320"
        height="320"
      />
    </header>

    <section class="work" aria-labelledby="selected-work">
      <div class="work-heading">
        <h2 id="selected-work">Selected work</h2>
        <a href="/projects" class="work-link">All projects &rarr;</a>
      </div>
      <div class="showcase-list">
        {
          projects.map((project) => (
            <ProjectShowcase
              title={project.data.title}
              description={project.data.description}
              summary={project.data.summary}
              role={project.data.role}
              year={project.data.year}
              tags={project.data.tags}
              images={project.data.images}
              href={project.data.href}
              detailHref={
                project.body?.trim() ? `/projects/${project.id}` : undefined
              }
            />
          ))
        }
      </div>
    </section>
  </main>
  <RevealOnScroll />
</BaseLayout>

<style lang="scss">
  main {
    display: flex;
    flex-direction: column;
    margin-bottom: 4rem;
  }

  .intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 3rem 0 3.5rem;

    @include respond-to("tablet") {
      padding: 4.5rem 0 5rem;
    }

    @include respond-to("desktop") {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: clamp(3rem, 8vw, 8rem);
    }
  }

  .intro-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .intro-avatar {
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid $color-accent-1;
    margin-bottom: 0.75rem;
    order: -1;

    @include respond-to("desktop") {
      width: clamp(15rem, 22vw, 20rem);
      height: clamp(15rem, 22vw, 20rem);
      border-width: 2px;
      margin: 0;
      order: 0;
      flex: 0 0 auto;
    }
  }

  h1 {
    display: flex;
    flex-direction: column;
    font-size: $fs-3xl;
    line-height: 1.1;

    @include respond-to("tablet") {
      font-size: $fs-4xl;
    }
  }

  .intro-name {
    color: $color-text;
  }

  .intro-role {
    color: $color-accent-2;
  }

  .intro-line {
    margin-top: 0.75rem;
    max-width: 52ch;
    color: color.adjust($color-accent-1, $lightness: -10%);
    line-height: 1.6;
  }

  .work-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba($color-accent-1, 0.35);
  }

  .work-link {
    color: $color-accent-1;
    text-decoration: none;
    transition: color 0.2s ease;

    &:hover {
      color: $color-accent-2;
    }
  }

  // Generous rhythm between bands: the whitespace is what makes each project
  // read as its own frame rather than a row in a list.
  .showcase-list {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    margin-top: 3rem;

    @include respond-to("tablet") {
      gap: 6.5rem;
      margin-top: 4rem;
    }
  }
</style>
